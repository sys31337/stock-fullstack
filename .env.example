# Optional overrides — hardcoded defaults used if unset
MONGODB_PORT=27018
MONGODB_ROOT_USER=stock_admin
MONGODB_ROOT_PASS=admin
MONGODB_DB_NAME=stock

# --- Relay / remote connection (see solustock-relay/README.md) ---
# Mode: 'host' (default) serves this machine's backend; 'client' connects to a
# remote Electron Host through the relay.
RELAY_MODE=host
# URL of the SoluStock Relay service (local, LAN, or remote).
RELAY_URL=http://127.0.0.1:4050
# Shared secret the relay requires (must match the relay's RELAY_TOKEN).
RELAY_TOKEN=change-me
# Stable identifier/name for this host shown to clients.
RELAY_HOST_ID=my-host
# Human-friendly display name clients see (default: 'SoluStock Host').
RELAY_HOST_NAME=My Host
# Host mode: access password clients must enter to link to this host
# (empty = open access). Can also be set in-app under Remote connection.
RELAY_HOST_PASSWORD=
# Client mode: the Host ID this app should connect to.
RELAY_TARGET_HOST=
# Client mode: local port for the HTTP proxy the renderer talks to.
RELAY_CLIENT_PORT=4032
# Host mode: local API base the relay bridge forwards requests to.
RELAY_LOCAL_API=http://127.0.0.1:3500
